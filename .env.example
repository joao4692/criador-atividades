# Copie para .env (cp .env.example .env) e ajuste. O .env NUNCA vai para o Git.

# --- Banco ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_troque
POSTGRES_DB=criador
# "db" é o nome do serviço no compose; 5432 é a porta dentro da rede do Docker.
DATABASE_URL=postgresql+psycopg://app:app_dev_troque@db:5432/criador

# --- Login (JWT) ---
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRE_MINUTES=60

# --- IA (Grok / xAI) ---
GROK_API_KEY=
GROK_MODEL=grok-4

# --- Backend ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Docker / máquina local ---
# Linux: resultado de "id -u". Windows/macOS: deixe 1000.
APP_UID=1000
# true se a recarga automática não perceber suas mudanças (comum no Windows).
WATCH_POLLING=false
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
